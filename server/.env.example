PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/techfest2026
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# secure | vulnerable  (vulnerable = only for the before-screenshots of the lab)
SECURITY_MODE=secure
# true exposes the deliberately weak /api/demo/login used for the injection demo. Never true in production.
ENABLE_DEMO=true
